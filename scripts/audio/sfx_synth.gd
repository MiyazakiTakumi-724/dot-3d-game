## 名前の音の波形（-1〜1、RATE Hz）。同じ名前なら毎回同じ。
static func render(name: String) -> PackedFloat32Array:
	var layers: Array = RECIPES.get(name, [])
	var total := 0.0
	for l in layers:
		total = maxf(total, float(l.get("t", 0.0)) + float(l["d"]))
	var out := PackedFloat32Array()
	out.resize(int(total * RATE) + 1)
	var rng := RandomNumberGenerator.new()
	rng.seed = hash(name)
	for l in layers:
		_add_layer(out, l, rng)
	var peak := 0.0
	for x in out:
		peak = maxf(peak, absf(x))
	if peak > 0.95:
		for i in out.size():
			out[i] *= 0.95 / peak
	return out

static func _add_layer(out: PackedFloat32Array, l: Dictionary, rng: RandomNumberGenerator) -> void:
	var wave: String = l.get("w", "sine")
	var f0 := float(l.get("f", 440.0))
	var f1 := float(l.get("f2", f0))
	var start := int(float(l.get("t", 0.0)) * RATE)
	var n := int(float(l["d"]) * RATE)
	var atk := maxf(1.0, float(l.get("a", 0.004)) * RATE)
	var vol := float(l.get("v", 0.3))
	var pw := float(l.get("p", 2.0))
	var lp := clampf(float(l.get("lp", 1.0)), 0.01, 1.0)
	var vib := float(l.get("vib", 0.0))
	var vf := float(l.get("vf", 0.0))
	var ratio := pow(f1 / f0, 1.0 / maxf(1.0, n)) if f0 > 0.0 and f1 > 0.0 else 1.0
	var f := f0
	var phase := 0.0
	var held := 0.0
	var y := 0.0
	for i in n:
		var k := start + i
		if k >= out.size():
			break
		var ff := f * (1.0 + vib * sin(TAU * vf * i / RATE)) if vib > 0.0 else f
		phase += ff / RATE
		var x := 0.0
		match wave:
			"sine":
				x = sin(TAU * phase)
			"square":
				x = 1.0 if fmod(phase, 1.0) < 0.5 else -1.0
			"saw":
				x = 2.0 * fmod(phase, 1.0) - 1.0
			"tri":
				x = 4.0 * absf(fmod(phase, 1.0) - 0.5) - 1.0
			"noise":
				if phase >= 1.0:
					phase = fmod(phase, 1.0)
					held = rng.randf_range(-1.0, 1.0)
				x = held
		y += lp * (x - y)  # こもらせる（1極のローパス）
		var env := minf(1.0, i / atk) * pow(1.0 - float(i) / n, pw)
		out[k] += y * env * vol
		f *= ratio

## 波形を Godot の音（16bit・1チャンネル）にする。
static func to_stream(samples: PackedFloat32Array) -> AudioStreamWAV:
	var bytes := PackedByteArray()
	bytes.resize(samples.size() * 2)
	for i in samples.size():
		bytes.encode_s16(i * 2, int(clampf(samples[i], -1.0, 1.0) * 32767.0))
	var s := AudioStreamWAV.new()
	s.format = AudioStreamWAV.FORMAT_16_BITS
	s.mix_rate = RATE
	s.stereo = false
	s.data = bytes
	return s

## 記憶のかけらの言葉（n は 1 から）。
static func fragment(n: int) -> String:
	return FRAGMENTS[n - 1] if n >= 1 and n <= FRAGMENTS.size() else ""

static func fragment_flag(n: int) -> String:
	return "frag_%d" % n

## 集めた記憶のかけらの数。
static func fragment_count(run_flags: Dictionary) -> int:
	var n := 0
	for i in FRAGMENTS.size():
		if run_flags.get(fragment_flag(i + 1), false):
			n += 1
	return n


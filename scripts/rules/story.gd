## 何体目の STORY_BOSSES か（defeated は倒したボスかを返す Callable か、名前 → true の辞書）。
static func story_bosses_defeated(run: RunState) -> int:
	var n := 0
	for b in STORY_BOSSES:
		if run.is_boss_defeated(b):
			n += 1
	return n

## ボス group を倒した直後に聞こえる、ブライトの声（STORY_BOSSES でなければ空）。
static func bright_voice_after(group: String, run: RunState) -> Array:
	if not group in STORY_BOSSES:
		return []
	var n := story_bosses_defeated(run)
	return BRIGHT_VOICE[n - 1] if n >= 1 and n <= BRIGHT_VOICE.size() else []


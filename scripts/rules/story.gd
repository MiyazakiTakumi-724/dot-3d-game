## 終わりの言葉。dark_king（闇の王を倒したか）で3ページ目が変わる
static func ending(flags: Dictionary) -> Array:
	var out := [
		"ブライトの目が、ゆっくりと 閉じた。",
		"空をおおっていた光が 消え、\n魔物たちは もとの けものに 戻っていった。",
	]
	if flags.get("dark_king", false):
		out.append("きみは 灯りの村へ 帰り、\n家族と 友だちの墓に 花を そなえた。")
	else:
		out.append("けれど 霧の谷には、まだ 黒い王がいる。\n村の仇は、まだ 終わっていない。")
	if flags.get("dark_king", false) and flags.get("all_frags", false):
		out.append_array(TRUE_ENDING)
		out.append("――ほんとうの おわり――\nこのあとも 冒険を つづけられる。")
	else:
		out.append("――おわり――\nこのあとも 冒険を つづけられる。")
	return out


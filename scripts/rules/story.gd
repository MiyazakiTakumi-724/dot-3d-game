## 進み具合。run は RunState（倒したぬしの数・闇の王・ブライト）。
static func flags(run: RunState) -> Dictionary:
	var region := RunState.REGION_BOSSES.size() - run.seal_bosses_left()
	return {
		"boss1": region >= 1,
		"mist": region >= MIST_BOSSES,
		"seal": run.seal_bosses_left() == 0,
		"dark_king": run.is_boss_defeated(DARK_KING),
		"cleared": run.cleared,
		"frag4": fragment_count(run.flags) >= 4,
		"frag8": fragment_count(run.flags) >= 8,
		"all_frags": fragment_count(run.flags) >= FRAGMENTS.size(),
		"garde_rest": run.is_boss_defeated(DARK_KING) and fragment_count(run.flags) >= FRAGMENTS.size(),
	}

## その人（PEOPLE の1つ）が今話す言葉。
static func lines(person: Dictionary, f: Dictionary) -> Array:
	for t in person["talk"]:
		var cond: String = t[0]
		if cond == "" or f.get(cond, false):
			return t[1]
	return []

## そのエリアの人と看板。
static func people(area_id: String) -> Array:
	return PEOPLE.get(area_id, [])

## 仕掛けのヒント（看板）。
static func gimmick_hint(kind: int) -> String:
	return GIMMICK_HINTS[kind] if kind >= 0 and kind < GIMMICK_HINTS.size() else ""

static func boss_beat(group: String) -> Array:
	return BOSS_BEATS.get(group, [])

## 看板・墓か（読む）、人か（話す）。
static func is_object(look: String) -> bool:
	return look in ["sign", "grave"]

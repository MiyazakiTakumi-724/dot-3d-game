## ボスを倒したあとの言葉。闇の王は、記憶のかけらを すべて集めていると変わる。
static func boss_beat_for(group: String, f: Dictionary) -> Array:
	if group == DARK_KING and f.get("all_frags", false):
		return GARDE_BEAT
	return boss_beat(group)

